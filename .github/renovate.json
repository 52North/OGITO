{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended"
    ],
    "baseBranches": [
        "test/renovate"
    ],
    "major": {
        "enabled": false
    },
    "ignorePaths": [
        "**/node_modules/**",
        "**/e2e/**",
        "**/dist/**",
        "img/**",
        "src/assets/**",
        "src/environments/**",
        "tools/street_names/**"
    ],
    "packageRules": [
        {
            "description": "All production dependencies (excluding subfolders)",
            "matchDepTypes": [
                "dependencies"
            ],
            "excludeFileNames": [
                "tools/**",
                "starter_project/**"
            ],
            "groupName": "production dependencies"
        },
        {
            "description": "All devDependencies (excluding subfolders)",
            "matchDepTypes": [
                "devDependencies"
            ],
            "excludeFileNames": [
                "tools/**",
                "starter_project/**"
            ],
            "groupName": "dev dependencies"
        },
        {
            "description": "All dependencies inside starter project folder (Docker images, etc.)",
            "matchFileNames": [
                "starter_project/**"
            ],
            "excludeFileNames": [
                "tools/**"
            ],
            "groupName": "starter project dependencies"
        },
        {
            "description": "All dependencies of image upload script",
            "matchFileNames": [
                "tools/image_upload/**"
            ],
            "excludeFileNames": [
                "starter_project/**",
                "src/**"
            ],
            "groupName": "tool image upload dependencies"
        },
        {
            "description": "All dependencies of geopy geocoder script",
            "matchFileNames": [
                "tools/geopy_geocoder/**"
            ],
            "excludeFileNames": [
                "starter_project/**",
                "src/**"
            ],
            "groupName": "tool geopy geocoder dependencies"
        }
    ]
}