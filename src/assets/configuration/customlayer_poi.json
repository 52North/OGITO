{
    "layername": "Point of Interest",
    "groupname": "Point of Interest Ratings",
    "header": "Select a Category",
    "labelField": "name",
    "iconHeightPxl": 38,
    "categories": 
        [
            {
                "id": "transport",
                "label": "Transport",
                "icon": "https://upload.wikimedia.org/wikipedia/commons/8/8e/Traintransportation.svg"
            },
            {
                "id": "health",
                "label": "Health",
                "icon": "https://upload.wikimedia.org/wikipedia/commons/a/a3/BSicon_HOSPITAL.svg"
            }, 
            {
                "id": "sightseeing",
                "label": "Sightseeing",
                "icon": "https://upload.wikimedia.org/wikipedia/commons/1/1b/Map_Icon_-_Attractions.png"
            },
            {
                "id": "recreation",
                "label": "Recreation",
                "icon": "https://upload.wikimedia.org/wikipedia/commons/thumb/2/27/Legenda_park_narodowy.svg/960px-Legenda_park_narodowy.svg.png"
            }
        ]
    ,
    "fields" : [
        {
            "id": "name",
            "label": "Name of Place",
            "type": "text",
            "placeholder": "type the name of the place",
            "required": true,
            "minLength": 3
        },
        {
            "id": "review",
            "label": "Review",
            "type": "textarea",
            "placeholder": "You can add your review of this place here",
            "readonly": false,
            "maxLength": 50,
            "rows": 8
        },
        {
            "id": "rating",
            "label": "Rating",
            "type": "number",
            "default": 5,
            "min": 1,
            "max": 10,
            "readonly": false,
            "required": true
        },
        {
            "id": "accessed by",
            "label": "Accessed By",
            "type": "select",
            "options": ["Car", "Bike", "Pedestrian", "Public Transport"],
            "readonly": false,
            "required": false
        },
        {
            "id": "date visited",
            "label": "Date Visited",
            "type": "date",
            "readonly": false,
            "required": true
        },
        {
            "id": "recommended",
            "label": "Would you recommend this place?",
            "type": "checkbox",
            "default": false,
            "required": false,
            "showInFeatureInfo": false
        }

    ]
}